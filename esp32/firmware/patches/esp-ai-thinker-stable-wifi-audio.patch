+static esp_err_t wifi_status_get_handler(httpd_req_t *req) {
+	wifi_ap_record_t ap = {0};
+	uint8_t protocol = 0;
+	wifi_bandwidth_t bandwidth = WIFI_BW_HT20;
+	wifi_ps_type_t ps_type = WIFI_PS_NONE;
+	char ssid[33] = {0};
+	char response[512] = {0};
+
+	esp_err_t ap_err = esp_wifi_sta_get_ap_info(&ap);
+	esp_err_t protocol_err = esp_wifi_get_protocol(WIFI_IF_STA, &protocol);
+	esp_err_t bandwidth_err = esp_wifi_get_bandwidth(WIFI_IF_STA, &bandwidth);
+	esp_err_t ps_err = esp_wifi_get_ps(&ps_type);
+
+	if (ap_err == ESP_OK) {
+		memcpy(ssid, ap.ssid, sizeof(ap.ssid));
+		ssid[sizeof(ssid) - 1] = '\0';
+	}
+
+	snprintf(response, sizeof(response),
+			 "{\"connected\":%s,\"ssid\":\"%s\",\"bssid\":\"%02x:%02x:%02x:%02x:%02x:%02x\","
+			 "\"primary_channel\":%u,\"second_channel\":%u,\"rssi\":%d,"
+			 "\"protocol\":%u,\"bandwidth\":%u,\"power_save\":%u,"
+			 "\"ap_error\":%d,\"protocol_error\":%d,\"bandwidth_error\":%d,\"power_save_error\":%d}",
+			 ap_err == ESP_OK ? "true" : "false", ssid,
+			 ap.bssid[0], ap.bssid[1], ap.bssid[2], ap.bssid[3], ap.bssid[4], ap.bssid[5],
+			 ap.primary, ap.second, ap.rssi, protocol, bandwidth, ps_type,
+			 ap_err, protocol_err, bandwidth_err, ps_err);
+
+	set_cors_headers(req);
+	httpd_resp_set_type(req, "application/json");
+	httpd_resp_sendstr(req, response);
+	return ESP_OK;
+}

+static void wifi_ps_none_task(void *pv) {
+  (void)pv;
+  while (true) {
+    esp_err_t err = esp_wifi_set_ps(WIFI_PS_NONE);
+    if (err != ESP_OK) {
+      ESP_LOGW(TAG, "failed to reassert WIFI_PS_NONE: %s", esp_err_to_name(err));
+    }
+    vTaskDelay(pdMS_TO_TICKS(10000));
+  }
+}
+
+static void ensure_wifi_ps_none_task(void) {
+  static bool wifi_ps_none_task_created = false;
+  if (!wifi_ps_none_task_created) {
+    BaseType_t r = xTaskCreate(wifi_ps_none_task, "wifi_ps_none", 2048, NULL,
+                               tskIDLE_PRIORITY + 1, NULL);
+    if (r != pdPASS) {
+      ESP_LOGW(TAG, "failed to create wifi_ps_none task");
+    } else {
+      wifi_ps_none_task_created = true;
+    }
+  }
+}

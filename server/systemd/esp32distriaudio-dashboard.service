[Unit]
Description=ESP32 Distri Audio Dashboard
After=network-online.target snapserver.service
Wants=network-online.target

[Service]
Type=simple
Environment=DASHBOARD_PORT=8080
Environment=LOG_DIR=/var/log/esp32distriaudio
ExecStart=/usr/bin/python3 /opt/esp32distriaudio/server/dashboard/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
